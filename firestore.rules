rules_version = '2';

// ----------------------------------------------------------------------------
// Skin Diary — Firestore Security Rules
//
// Data model (CLAUDE.md §3, §4):
//   users/{uid}                                 — user profile
//   users/{uid}/dailyRecords/{yyyy-mm-dd}       — one record per user/day
//
// Defense-in-depth notes:
//   - Default deny: any path not matched below is rejected.
//   - Future-date writes are blocked at the rules level (not only in the UI).
//     `request.time` is UTC; we use a 1-day forward tolerance window so users
//     in any timezone can still record "today" without false rejections.
//   - Field-level validation prevents writes from a hostile client bypassing
//     the UI (size limits, key whitelist, type checks).
// ----------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helpers ------------------------------------------------------------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Parse a "yyyy-mm-dd" string into a UTC midnight timestamp.
    // Rules language has no string→timestamp parser, so we slice the
    // fixed-width substrings and feed integers into timestamp.date().
    function parseDateKey(date) {
      return timestamp.date(
        int(date[0:4]),
        int(date[5:7]),
        int(date[8:10])
      );
    }

    // yyyy-mm-dd format AND not in the future.
    // We compare against `request.time + 1 day` so users in any timezone
    // (e.g. KST 00:00–09:00 when UTC is still on the previous day) can
    // record their local "today" without false rejections. Inputs more
    // than ~1 day past UTC now are still rejected.
    function isValidDate(date) {
      return date.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && parseDateKey(date) <= request.time + duration.value(1, 'd');
    }

    function isValidPhotos(photos) {
      return photos is map
             && photos.keys().hasOnly(['front', 'left', 'right'])
             && (!('front' in photos) || photos.front is bool)
             && (!('left'  in photos) || photos.left  is bool)
             && (!('right' in photos) || photos.right is bool);
    }

    // String OR null, with max length. Empty string allowed (skip behavior).
    function isShortText(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // -- Consent helpers ----------------------------------------------------
    //
    // Consent fields (terms*, privacy*, ageConfirmed) are written ONCE — either
    // at create-time (password sign-up) or via a single deferred→full
    // transition (Google sign-in followed by /signup/consent gate). After the
    // transition, every field becomes immutable. A future "re-consent" flow
    // (new ToS version) will need a dedicated server-mediated path.
    function consentFields() {
      return [
        'termsVersion', 'privacyVersion', 'sensitivePhotoVersion',
        'ageConfirmed',
        'termsAgreedAt', 'privacyAgreedAt', 'sensitivePhotoAgreedAt'
      ];
    }

    // Consent shape validation. Version strings are pinned to YYYY-MM-DD so an
    // attacker can't write an opaque "v999" and break the audit trail.
    //
    // sensitivePhotoVersion covers the explicit opt-in for storing facial
    // photos (sensitive personal data under KR PIPA). It is separate from the
    // generic privacyVersion because the user must be able to refuse photo
    // collection while still using the lifestyle-only features.
    function hasFullConsent(data) {
      return data.termsVersion is string
             && data.termsVersion.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && data.privacyVersion is string
             && data.privacyVersion.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && data.sensitivePhotoVersion is string
             && data.sensitivePhotoVersion.matches('^\\d{4}-\\d{2}-\\d{2}$')
             && data.ageConfirmed == true
             // Server-stamped via serverTimestamp(); must equal request.time so
             // a hostile client can't back-date consent.
             && data.termsAgreedAt == request.time
             && data.privacyAgreedAt == request.time
             && data.sensitivePhotoAgreedAt == request.time;
    }
    function hasDeferredConsent(data) {
      return data.termsVersion == null
             && data.privacyVersion == null
             && data.sensitivePhotoVersion == null
             && data.ageConfirmed == null
             && data.termsAgreedAt == null
             && data.privacyAgreedAt == null
             && data.sensitivePhotoAgreedAt == null;
    }

    // Password sign-up MUST carry full consent — the dedicated sign-up screen
    // shows the consent checkboxes, so there's no legitimate path that omits
    // them. A devtools-bypassed client would otherwise be able to register
    // without agreeing (legal risk). Google sign-in is allowed to defer
    // because Google's OAuth popup happens before our consent UI; a follow-up
    // consent gate handles deferred Google users at session-start.
    function isValidConsentOnCreate(data) {
      return data.provider == 'password'
               ? hasFullConsent(data)
               : (hasFullConsent(data) || hasDeferredConsent(data));
    }

    // -- User profile -------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'provider', 'createdAt', 'updatedAt',
                          'termsVersion', 'privacyVersion',
                          'sensitivePhotoVersion', 'ageConfirmed',
                          'termsAgreedAt', 'privacyAgreedAt',
                          'sensitivePhotoAgreedAt']
                       )
                    && request.resource.data.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.provider in ['google', 'password']
                    && isValidConsentOnCreate(request.resource.data);

      allow update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'provider', 'createdAt', 'updatedAt',
                          'termsVersion', 'privacyVersion',
                          'sensitivePhotoVersion', 'ageConfirmed',
                          'termsAgreedAt', 'privacyAgreedAt',
                          'sensitivePhotoAgreedAt']
                       )
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.provider in ['google', 'password']
                    // Consent fields: either fully immutable (no-op),
                    // or a one-shot deferred→full transition. Once any
                    // consent field is non-null, it can never change.
                    && (
                         request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(consentFields()) == false
                         || (
                              hasDeferredConsent(resource.data)
                              && hasFullConsent(request.resource.data)
                            )
                       );

      // Profiles are not user-deletable from the client. Account deletion
      // must go through an admin/server flow.
      allow delete: if false;

      // -- Daily records --------------------------------------------------
      match /dailyRecords/{date} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
                      && isValidDate(date)
                      && request.resource.data.keys().hasOnly(
                           ['date', 'photos', 'water', 'food',
                            'cosmetic', 'exercise', 'memo',
                            'createdAt', 'updatedAt',
                            'lifestyleSavedAt', 'isDraft']
                         )
                      && request.resource.data.date == date
                      && isValidPhotos(request.resource.data.photos)
                      && request.resource.data.water is int
                      && request.resource.data.water >= 0
                      && request.resource.data.water <= 30
                      && request.resource.data.exercise is bool
                      && isShortText(request.resource.data.food, 200)
                      && isShortText(request.resource.data.cosmetic, 200)
                      && isShortText(request.resource.data.memo, 1000);

        allow update: if isOwner(uid)
                      && isValidDate(date)
                      && request.resource.data.keys().hasOnly(
                           ['date', 'photos', 'water', 'food',
                            'cosmetic', 'exercise', 'memo',
                            'createdAt', 'updatedAt',
                            'lifestyleSavedAt', 'isDraft']
                         )
                      && request.resource.data.date == date
                      && isValidPhotos(request.resource.data.photos)
                      && request.resource.data.water is int
                      && request.resource.data.water >= 0
                      && request.resource.data.water <= 30
                      && request.resource.data.exercise is bool
                      && isShortText(request.resource.data.food, 200)
                      && isShortText(request.resource.data.cosmetic, 200)
                      && isShortText(request.resource.data.memo, 1000);

        // Records are append-only from the user perspective (avoid accidental
        // wipe). Use update with cleared fields if a "reset" UX is needed.
        allow delete: if false;
      }
    }

    // -- Audit log ----------------------------------------------------------
    //
    // Top-level append-only `audit` collection. Server (Admin SDK) is the only
    // writer; clients never write. Each document carries `uid` so the owner can
    // read their own activity history, but no one — including the user — can
    // mutate or delete entries. Operator (single-tenant maker) is intentionally
    // also subject to these rules: a cross-user query for incident response
    // must go through Admin SDK (server-side), not the client SDK.
    //
    // Document shape (enforced by server, not rules):
    //   { uid, event, occurredAt, source: 'client'|'server', meta: map }
    match /audit/{auditId} {
      // Owner may read own events. resource.data.uid must match auth uid.
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      // Clients can NEVER write. Server uses Admin SDK which bypasses rules.
      allow write: if false;
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
