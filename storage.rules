rules_version = '2';

// ----------------------------------------------------------------------------
// Skin Diary — Storage Security Rules
//
// Path contract (CLAUDE.md §1, §2):
//   /{uid}/{yyyy-mm-dd}/{front|left|right}.jpg
//
// Image format (enforced by client `lib/image/normalize.ts` AND by these
// rules):
//   - 1024x1024 JPG, quality ~0.82, EXIF stripped
//   - Expected size: 200~400KB; 500KB is the bypass cap.
// ----------------------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {

    // -- Helpers ------------------------------------------------------------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidDate(date) {
      return date.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isAllowedFilename(filename) {
      return filename.matches('^(front|left|right)\\.jpg$');
    }

    // -- Daily photos -------------------------------------------------------
    match /{uid}/{date}/{filename} {
      // Read is blocked at the client SDK level (CLAUDE.md §9.2).
      // All photo reads MUST go through POST /api/photo/signed-url, which
      // uses Admin SDK to issue a short-lived V4 signed URL (10-min TTL).
      // Rationale:
      //  - Client `getDownloadURL()` returns a long-lived public URL that,
      //    once leaked (chat, CDN, logs), grants permanent access.
      //  - Server-mediated signed URLs let us scope to TTL, enforce
      //    consent/owner re-checks, and log access centrally.
      allow read: if false;

      allow write: if isOwner(uid)
                   && isValidDate(date)
                   && isAllowedFilename(filename)
                   && request.resource.size < 500 * 1024
                   && request.resource.contentType == 'image/jpeg';

      // Owner may delete to replace a photo (re-shoot UX).
      allow delete: if isOwner(uid);
    }

    // Default deny for any path outside the contract above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
