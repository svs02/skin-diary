      "font-body":    { "$value": "'Noto Sans KR', sans-serif", "$type": "fontFamily", "$description": "일반 UI 텍스트" },
      "size-hero":       { "$value": "58px", "$type": "fontSize", "$description": "홈 날짜 대형 숫자" },
