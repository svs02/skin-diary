# =============================================================================
# Skin Diary — Environment Variables Template
# =============================================================================
#
# 사용 방법:
#   - 로컬 개발:    이 파일을 `.env.local`로 복사 후 dev 프로젝트 키로 채운다.
#   - Vercel:       이 파일은 채우지 않는다. Vercel Dashboard → Settings →
#                   Environment Variables 에서 Preview/Production 별로 등록.
#
# 환경 분리 원칙 (docs/ENVIRONMENT_SETUP.md 참조):
#   - Local         → Firebase dev 프로젝트 (예: `skin-diary-ea893`)
#   - Vercel Preview→ Firebase dev 프로젝트 (PR 미리보기 공유)
#   - Vercel Prod   → Firebase prod 프로젝트 (예: `skin-diary-prod`)
#
# 클라이언트 키(`NEXT_PUBLIC_*`)는 번들에 포함되어 노출된다.
# 실제 방어선은:
#   1. GCP API key의 HTTP referrer 제한
#   2. Firebase Authorized Domains 화이트리스트
#   3. Firestore / Storage Security Rules
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Web SDK (client-side)
# Firebase Console > Project Settings > General > Your apps > SDK setup
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Public site URL (OG / canonical / metadataBase)
#   - Production:  https://skindiary.net
#   - Preview:     미설정 시 production URL로 폴백 (또는 Vercel 자동 URL로 덮어쓰기)
#   - Local:       http://localhost:3000 권장
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://skindiary.net

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-side only — Vercel Function 전용)
#
# 발급:
#   Firebase Console → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"
#   다운로드된 JSON에서 project_id / client_email / private_key 3개 필드를 사용.
#
# 보안:
#   - 클라이언트 번들에 절대 포함되지 않도록 `NEXT_PUBLIC_` 접두사 금지.
#   - Vercel에서는 Sensitive 타입으로 등록 (Preview=dev키, Production=prod키 분리).
#   - PRIVATE_KEY는 줄바꿈을 `\n` 문자열로 escape한 1줄 형태로 저장.
#     예) "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#   - 이 키가 노출되면 모든 사용자 데이터에 대한 관리자 권한이 유출된다 — 즉시 회전.
#
# 사용처:
#   - app/api/account/delete/route.ts (계정 삭제)
#   - 향후 추가될 모든 서버 전용 라우트
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
